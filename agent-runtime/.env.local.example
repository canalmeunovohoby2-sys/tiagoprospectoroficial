# Agent Runtime LOCAL — variáveis do ambiente (NUNCA use secrets globais aqui).
# Copie para agent-runtime/.env.local

# Projeto Supabase (não-sensíveis: URL pública + anon key, como no frontend)
SUPABASE_URL=https://efgwszjjtjebqdzziqfs.supabase.co
SUPABASE_ANON_KEY=coloque_a_publishable_key_anon_aqui

# Opcional: aponta direto para as edge functions do projeto (mesmo domínio do SUPABASE_URL)
SUPABASE_FUNCTIONS_URL=https://efgwszjjtjebqdzziqfs.supabase.co/functions/v1

# Porta/Host do runtime local (padrões seguros)
PORT=8787
HOST=127.0.0.1

# IMPORTANTE: NÃO defina RUNTIME_GATEWAY_SECRET nem AGENT_TICKET_SECRET aqui.
# O runtime local autentica cada usuário pelo JWT dele (sem segredos globais).
