# Frontend (Vite) — chaves públicas
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Edge Functions (server-side). Configure o valor real nos secrets do Supabase:
#   supabase secrets set GOOGLE_PLACES_API_KEY=... --project-ref <ref>
#   supabase secrets set GEOAPIFY_API_KEY=... --project-ref <ref>
# Nunca versione o valor real.
GOOGLE_PLACES_API_KEY=""
GEOAPIFY_API_KEY=""

# Google Maps scraper self-hosted (conor-is-my-name/google-maps-scraper).
# GMAPS_SCRAPER_URL deve ser a URL PÚBLICA com https:// (ex.: https://xxx.up.railway.app).
# Hostnames internos (*.railway.internal) NÃO são alcançáveis pela Edge Function.
GMAPS_SCRAPER_URL=""
GMAPS_SCRAPER_ENABLED="false"
GMAPS_SCRAPER_API_KEY=""

# Segunda fonte: mapScraper (christivn/mapScraper) via microservico HTTP (FastAPI).
# MAP_SCRAPER_URL deve ser a URL PUBLICA com https://.
MAP_SCRAPER_URL=""
MAP_SCRAPER_ENABLED="false"
MAP_SCRAPER_API_KEY=""
